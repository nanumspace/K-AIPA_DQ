{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"], "@engine/*": ["../dq-ts/src/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/renderer/env.d.ts", "../dq-ts/src/types.ts", "../dq-ts/src/date.ts"]
}
